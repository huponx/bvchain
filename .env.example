# Copy to .env and `set -a; source .env; set +a` (or before `make bvctl-run`, make does not read .env).
# BV portal account (bvchain, bvreport, bvctl report)
BV_USERNAME=
BV_PASSWORD=
BV_OTP_SECRET=

# courier (gRPC) that delivers the Telegram messages
COURIER_TARGET=localhost:9091
COURIER_TIMEOUT=10s
COURIER_INSECURE=true
# in a cluster: the projected ServiceAccount token (audience courier), re-read when it rotates
COURIER_TOKEN_FILE=
# a local courier started with COURIER_S2S_TOKEN (ENV=local): static Bearer token
COURIER_S2S_TOKEN=
# Telegram chat that receives the messages
TELEGRAM_CHAT_ID=
# template language: vi or en
NOTIFY_LOCALE=vi

# jobs only
# random sleep up to this value before the run (the check-in time varies)
DELAY=0s
# bvchain: also send a message after a successful check-in / check-out
NOTIFICATION_SUCCESS_ENABLED=false
# bvreport: send even when no day is missing
REPORT_ALWAYS_SEND=false

# logging
LOG_LEVEL=info
LOG_ENCODING=console
SERVICE_NAME=
ENV=local
